# Database connection string (MySQL / MariaDB)
DATABASE_URL="mysql://username:password@localhost:3306/movies_snishad"

# JWT Secret for Admin Authentication (generate a secure random 32+ char string)
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-2026"

# Internal Shared API Key between Frontend and Backend
INTERNAL_API_KEY="your-secure-internal-api-key-2026"

# Allowed Frontend Origins (comma separated)
ALLOWED_FRONTEND_ORIGINS="http://localhost:3000,http://localhost:3001,https://yourdomain.com"

# Public Site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# The Movie Database (TMDB) API Key v3 (get from https://www.themoviedb.org/settings/api)
TMDB_API_KEY="your-tmdb-api-key-here"

# Upstream Direct Download Provider
DOWNLOAD_API_URL="https://02moviedownloader.top/"

# Initial Default Admin Credentials
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="YourStrongPassword123!"
